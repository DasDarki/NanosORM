--- @ManyToMany maps a field to a collection of entities connected through a join table. Without mappedBy it is the owning side,
--- with mappedBy the inverse side. Both sides can be changed, the Collection writes the change to the owning side.
---
---     @ManyToMany(joinTable = "user_groups")
---     groups: Collection<GroupModel> = new Collection()
---
---     @ManyToMany(mappedBy = "groups")
---     members: Collection<UserModel> = new Collection()
---
--- The join table defaults to the owner table and the field name, like "user_groups". The mapping is generated by @Entity.

export local annotation = {
    targets = { "ClassField" },
    params = {
        target = { type = "string", required = false },
        mappedBy = { type = "string", required = false },
        inversedBy = { type = "string", required = false },
        joinTable = { type = "string", required = false },
        joinColumn = { type = "string", required = false },
        inverseJoinColumn = { type = "string", required = false },
        orderBy = { type = "string", required = false },
        cascade = { type = "string", required = false },
        fetch = { type = "string", required = false }
    }
}

export function apply(target, args)
    if args.mappedBy ~= nil and (args.joinTable ~= nil or args.joinColumn ~= nil or args.inverseJoinColumn ~= nil or args.inversedBy ~= nil) then
        error("@ManyToMany with mappedBy is the inverse side and cannot define the join table or inversedBy")
    end

    return target
end
