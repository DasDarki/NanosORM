--- @ManyToOne maps a field to a single entity whose id is stored in a foreign key column. This is always the owning side.
--- The target is taken from the field type, the foreign key is nullable if the field type is nullable.
---
---     @ManyToOne(onDelete = "CASCADE")
---     owner: UserModel
---
---     @ManyToOne(joinColumn = "guild_ref", inversedBy = "members")
---     guild: GuildModel?
---
--- cascade passes "persist", "remove" or "persist, remove" on to the referenced entity. fetch = "eager" loads it with every query.
--- The mapping is generated by @Entity.

export local annotation = {
    targets = { "ClassField" },
    params = {
        target = { type = "string", required = false },
        joinColumn = { type = "string", required = false },
        nullable = { type = "boolean", required = false },
        onDelete = { type = "string", required = false },
        cascade = { type = "string", required = false },
        fetch = { type = "string", required = false },
        inversedBy = { type = "string", required = false }
    }
}

export function apply(target, args)
    return target
end
