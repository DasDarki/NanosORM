--- @DiscriminatorValue sets the value stored in the discriminator column for instances of an entity of a single table inheritance
--- hierarchy. Without it the class name in snake case without a Model suffix is used, like "car" for CarModel.
--- The mapping is generated by @Entity.

export local annotation = {
    targets = { "Class" },
    params = {
        value = { type = "string", required = true }
    }
}

export function apply(target, args)
    return target
end
