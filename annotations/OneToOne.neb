--- @OneToOne maps a field to a single entity. Without mappedBy it is the owning side with a unique foreign key column,
--- with mappedBy it is the inverse side of the owning OneToOne relation on the target.
---
---     @OneToOne(cascade = "persist, remove")
---     profile: ProfileModel?
---
---     @OneToOne(mappedBy = "profile")
---     user: UserModel?
---
--- The mapping is generated by @Entity.

export local annotation = {
    targets = { "ClassField" },
    params = {
        target = { type = "string", required = false },
        mappedBy = { type = "string", required = false },
        inversedBy = { type = "string", required = false },
        joinColumn = { type = "string", required = false },
        nullable = { type = "boolean", required = false },
        onDelete = { type = "string", required = false },
        cascade = { type = "string", required = false },
        fetch = { type = "string", required = false },
        orphanRemoval = { type = "boolean", required = false }
    }
}

export function apply(target, args)
    if args.mappedBy ~= nil and (args.joinColumn ~= nil or args.onDelete ~= nil or args.inversedBy ~= nil) then
        error("@OneToOne with mappedBy is the inverse side and cannot define joinColumn, onDelete or inversedBy")
    end

    return target
end
