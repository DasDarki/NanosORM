--- @OneToMany maps a field to the collection of entities whose ManyToOne relation named by mappedBy points back. This is the inverse side,
--- changes are written through the owning ManyToOne relation, which the Collection keeps in sync.
---
---     @OneToMany(mappedBy = "owner", orderBy = "createdAt DESC")
---     houses: Collection<HouseModel> = new Collection()
---
--- orderBy accepts several entries separated by commas. orphanRemoval deletes members removed from the collection.
--- The mapping is generated by @Entity.

export local annotation = {
    targets = { "ClassField" },
    params = {
        mappedBy = { type = "string", required = true },
        target = { type = "string", required = false },
        orderBy = { type = "string", required = false },
        cascade = { type = "string", required = false },
        fetch = { type = "string", required = false },
        orphanRemoval = { type = "boolean", required = false }
    }
}

export function apply(target, args)
    return target
end
