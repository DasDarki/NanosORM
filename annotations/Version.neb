--- @Version marks an integer field as version number for optimistic locking. It implies @Column with the type "integer".
--- Every update increments the version and only succeeds if the row still has the version the entity was loaded with,
--- so changes made at the same time by someone else make the flush fail instead of being overwritten.
---
---     @Version
---     version: number = 1
---
--- The mapping is generated by @Entity.

export local annotation = {
    targets = { "ClassField" },
    params = {}
}

export function apply(target, args)
    return target
end
