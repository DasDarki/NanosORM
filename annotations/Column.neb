--- @Column maps a field to a database column. Every parameter is optional:
--- the type is taken from the field type, the column name is the field name in snake case
--- and the column is nullable if the field type is nullable.
---
---     @Column
---     username: string
---
---     @Column(name = "user_name", length = 32, unique = true)
---     username: string
---
---     @Column(type = "integer")
---     level: number
---
--- The mapping itself is generated by @Entity on the class, which reads this annotation from the field.

export local annotation = {
    targets = { "ClassField" },
    params = {
        name = { type = "string", required = false },
        type = { type = "string", required = false },
        length = { type = "number", required = false },
        precision = { type = "number", required = false },
        scale = { type = "number", required = false },
        unique = { type = "boolean", required = false },
        nullable = { type = "boolean", required = false },
        currency = { type = "string", required = false }
    }
}

export function apply(target, args)
    if args.length ~= nil and args.length <= 0 then
        error("@Column length has to be positive")
    end

    if args.scale ~= nil and args.precision == nil then
        error("@Column scale needs a precision")
    end

    return target
end
