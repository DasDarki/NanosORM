--- @UniqueConstraint makes the combination of fields unique. On the class it covers the fields listed in fields, on a field it covers that field.
--- Relations are covered by their foreign key column. The name defaults to uniq_<table>_<columns>.
---
---     @Entity
---     @UniqueConstraint(fields = "guild, name")
---     class PlayerModel extends Model
---         @Column
---         @UniqueConstraint
---         nickname: string
---     end
---
--- The mapping is generated by @Entity.

export local annotation = {
    targets = { "Class", "ClassField" },
    params = {
        fields = { type = "string", required = false },
        name = { type = "string", required = false }
    }
}

export function apply(target, args)
    if target.__kind == "ClassDecl" and args.fields == nil then
        error("@UniqueConstraint on a class needs fields, for example @UniqueConstraint(fields = \"guild, name\")")
    elseif target.__kind ~= "ClassDecl" and args.fields ~= nil then
        error("@UniqueConstraint on a field covers that field, list several fields with @UniqueConstraint on the class")
    end

    return target
end
