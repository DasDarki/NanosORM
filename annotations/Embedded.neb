--- @Embedded stores an object of an @Embeddable class in columns of the entity table. The class is taken from the field type.
--- The column names get the prefix in front, which defaults to the field name in snake case followed by an underscore, "" removes it.
--- A nullable field type allows nil, which stores NULL in all columns. Otherwise the field always holds an object.
---
---     @Embedded
---     address: Address
---
---     @Embedded(prefix = "bill_")
---     billingAddress: Address?
---
--- The mapping is generated by @Entity.

export local annotation = {
    targets = { "ClassField" },
    params = {
        prefix = { type = "string", required = false },
        nullable = { type = "boolean", required = false }
    }
}

export function apply(target, args)
    return target
end
