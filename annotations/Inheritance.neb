--- @Inheritance makes an @Entity the root of a single table inheritance hierarchy. Entities extending it are stored in the same table,
--- the discriminator column, "type" by default, holds which class a row belongs to. Queries of the root return instances of the right
--- subclasses, queries of a subclass only match its rows and the rows of the classes extending it. The root can be abstract.
---
---     @Entity
---     @Inheritance(column = "kind")
---     abstract class VehicleModel
---         @Id
---         vehicleID: Uuid?
---     end
---
---     @Entity
---     @DiscriminatorValue("car")
---     class CarModel extends VehicleModel
---         @Column
---         doors: number = 4
---     end
---
--- The mapping is generated by @Entity.

export local annotation = {
    targets = { "Class" },
    params = {
        column = { type = "string", required = false },
        length = { type = "number", required = false }
    }
}

export function apply(target, args)
    return target
end
