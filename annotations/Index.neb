--- @Index adds an index for faster queries. On the class it covers the fields listed in fields, on a field it covers that field.
--- Relations are indexed by their foreign key column. The name defaults to idx_<table>_<columns>.
---
---     @Entity
---     @Index(fields = "guild, rank")
---     class PlayerModel extends Model
---         @Column
---         @Index
---         level: number
---     end
---
--- The mapping is generated by @Entity.

export local annotation = {
    targets = { "Class", "ClassField" },
    params = {
        fields = { type = "string", required = false },
        name = { type = "string", required = false }
    }
}

export function apply(target, args)
    if target.__kind == "ClassDecl" and args.fields == nil then
        error("@Index on a class needs fields, for example @Index(fields = \"guild, rank\")")
    elseif target.__kind ~= "ClassDecl" and args.fields ~= nil then
        error("@Index on a field covers that field, list several fields with @Index on the class")
    end

    return target
end
