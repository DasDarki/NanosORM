local DAYS_IN_MONTH: number[] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 }

--- The days of the week following ISO 8601, starting with Monday as 1.
export enum DayOfWeek
  Monday = 1
  Tuesday = 2
  Wednesday = 3
  Thursday = 4
  Friday = 5
  Saturday = 6
  Sunday = 7
end

--- The units used to manipulate, truncate and compare DateTime objects.
export enum TimeUnit
  Millisecond = 0
  Second = 1
  Minute = 2
  Hour = 3
  Day = 4
  Week = 5
  Month = 6
  Year = 7
end

--- Static helpers for gregorian calendar calculations.
export class Calendar

  --- Converts a gregorian date into days since the unix epoch.
  static function daysFromCivil(year: number, month: number, day: number): number
    local y = year
    if month <= 2 then
      y = y - 1
    end

    local era = y // 400
    local yearOfEra = y - era * 400
    local shiftedMonth = (month + 9) % 12
    local dayOfYear = (153 * shiftedMonth + 2) // 5 + day - 1
    local dayOfEra = yearOfEra * 365 + yearOfEra // 4 - yearOfEra // 100 + dayOfYear
    return era * 146097 + dayOfEra - 719468
  end

  --- Converts days since the unix epoch into a gregorian year, month and day.
  static function civilFromDays(days: number): (number, number, number)
    local shifted = days + 719468
    local era = shifted // 146097
    local dayOfEra = shifted - era * 146097
    local yearOfEra = (dayOfEra - dayOfEra // 1460 + dayOfEra // 36524 - dayOfEra // 146096) // 365
    local year = yearOfEra + era * 400
    local dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra // 4 - yearOfEra // 100)
    local shiftedMonth = (5 * dayOfYear + 2) // 153
    local day = dayOfYear - (153 * shiftedMonth + 2) // 5 + 1
    local month = shiftedMonth < 10 and shiftedMonth + 3 or shiftedMonth - 9
    if month <= 2 then
      year = year + 1
    end

    return year, month, day
  end

  --- Returns the ISO day of the week from 1 for Monday to 7 for Sunday for the given days since the unix epoch.
  static function weekdayFromDays(days: number): number
    return (days + 3) % 7 + 1
  end

  --- Returns whether the given year is a leap year.
  static function isLeapYear(year: number): boolean
    return (year % 4 == 0 and year % 100 ~= 0) or year % 400 == 0
  end

  --- Returns the amount of days in the given month of the given year.
  static function daysInMonth(year: number, month: number): number
    if month == 2 and Calendar.isLeapYear(year) then
      return 29
    end

    return DAYS_IN_MONTH[month]
  end

  --- Returns the amount of days in the given year.
  static function daysInYear(year: number): number
    return Calendar.isLeapYear(year) and 366 or 365
  end

  --- Returns the amount of ISO 8601 weeks in the given year, either 52 or 53.
  static function weeksInYear(year: number): number
    local function weekdayOffset(y: number): number
      return (y + y // 4 - y // 100 + y // 400) % 7
    end

    if weekdayOffset(year) == 4 or weekdayOffset(year - 1) == 3 then
      return 53
    end

    return 52
  end

  --- Returns whether the given year, month and day form a valid date.
  static function isValidDate(year: number, month: number, day: number): boolean
    if month < 1 or month > 12 or month % 1 ~= 0 or day % 1 ~= 0 or year % 1 ~= 0 then
      return false
    end

    return day >= 1 and day <= Calendar.daysInMonth(year, month)
  end

  --- Returns whether the given hour, minute, second and millisecond form a valid time of day.
  static function isValidTime(hour: number, minute: number, second: number, millisecond: number): boolean
    return hour >= 0 and hour <= 23 and hour % 1 == 0
      and minute >= 0 and minute <= 59 and minute % 1 == 0
      and second >= 0 and second <= 59 and second % 1 == 0
      and millisecond >= 0 and millisecond <= 999 and millisecond % 1 == 0
  end

  --- Returns the day of the week of the given date.
  static function dayOfWeek(year: number, month: number, day: number): DayOfWeek
    return Calendar.weekdayFromDays(Calendar.daysFromCivil(year, month, day)) as DayOfWeek
  end
end
