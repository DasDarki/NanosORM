import { ColumnMetadata, EntityMetadata, MetadataRegistry, GenerationStrategy, RelationMetadata, RelationKind, IndexMetadata, EmbeddableMetadata, EmbeddedMetadata } from "./Metadata"
import { TypeRegistry } from "./TypeRegistry"
import { toSnakeCase, deriveTableName } from "./Naming"
import { getCallingPackage } from "./PackageScope"

local function createLuaClass(name: string): any
  local entityClass: any = {}
  entityClass.__index = entityClass
  entityClass.__name = name
  entityClass.new = function(values: any): any
    local instance = setmetatable({}, entityClass)
    if values ~= nil then
      for key, value in pairs(values) do
        instance[key] = value
      end
    end

    local metadata = MetadataRegistry.get(entityClass)
    if metadata ~= nil then
      for _, embedded in ipairs(metadata.embeddeds) do
        if not embedded.nullable and rawget(instance, embedded.fieldName) == nil then
          rawset(instance, embedded.fieldName, embedded:createInstance())
        end
      end
    end

    return instance
  end

  return entityClass
end

--- Builds the mapping of an entity class step by step. Column options like length or unique apply to the column added last.
---
--- Nebra classes get the same calls generated by the @Entity, @Column and @Id annotations. In Lua it is used directly:
---
---     local User = NanosORM.entity("User")
---       :column("userID", "Uuid"):id()
---       :column("username", "string"):length(32):unique()
---       :manyToOne("guild", "Guild"):onDelete("SET NULL")
---       :oneToMany("houses", "House", "owner"):orderBy("createdAt DESC")
---       :build()
---
--- Relation options like joinColumn or cascade apply to the relation added last.
---
--- Embeddables are classes whose fields are stored in prefixed columns of the entities embedding them. They only have columns:
---
---     local Address = NanosORM.embeddable("Address")
---       :column("street", "string")
---       :column("city", "string")
---       :build()
---
---     NanosORM.entity("House"):column("id", "integer"):id():embedded("address", Address):build()
---
--- creates the columns address_street and address_city on the house table.
export class EntityBuilder

  local _entityClass: any = nil
  local _className: string = ""
  local _tableName: string? = nil
  local _mappedSuperclass: boolean = false
  local _columns: ColumnMetadata[] = {}
  local _relations: RelationMetadata[] = {}
  local _indexes: IndexMetadata[] = {}
  local _current: ColumnMetadata? = nil
  local _currentRelation: RelationMetadata? = nil
  local _embeddable: boolean = false
  local _embeddeds: { fieldName: string, target: any, prefix: string?, nullable: boolean }[] = {}
  local _currentEmbedded: { fieldName: string, target: any, prefix: string?, nullable: boolean }? = nil
  local _createdClass: boolean = false
  local _inheritance: { columnName: string, length: number }? = nil
  local _discriminatorValue: string? = nil
  local _abstract: boolean = false

  --- Starts the mapping of the given class table. A string creates a new Lua class with that name, which build returns.
  --- Without a table name it is derived from the class name. Mapped superclasses only pass their columns on to subclasses.
  constructor(entityClass: any, tableName: string? = nil, mappedSuperclass: boolean = false, embeddable: boolean = false)
    if entityClass is string then
      self._entityClass = createLuaClass(entityClass)
      self._className = entityClass
      self._createdClass = true
    elseif type(entityClass) == "table" then
      self._entityClass = entityClass
      self._className = tostring(rawget(entityClass, "__name") ?? "Entity")
    else
      error("An entity needs a class table or a class name", 2)
    end

    self._tableName = tableName
    self._mappedSuperclass = mappedSuperclass
    self._embeddable = embeddable
  end

  local function requireColumn(option: string): ColumnMetadata
    local current = self._current
    if current == nil or self._currentRelation ~= nil then
      error("'" .. option .. "' has to follow a column", 3)
    end

    return current
  end

  local function requireRelation(option: string): RelationMetadata
    local current = self._currentRelation
    if current == nil then
      error("'" .. option .. "' has to follow a relation", 3)
    end

    return current
  end

  local function requireNewField(fieldName: string): void
    for index = 1, #self._columns do
      if self._columns[index].fieldName == fieldName then
        error("Field '" .. fieldName .. "' is mapped twice", 3)
      end
    end

    for index = 1, #self._relations do
      if self._relations[index].fieldName == fieldName then
        error("Field '" .. fieldName .. "' is mapped twice", 3)
      end
    end

    for _, embedded in ipairs(self._embeddeds) do
      if embedded.fieldName == fieldName then
        error("Field '" .. fieldName .. "' is mapped twice", 3)
      end
    end
  end

  local function requireEntity(option: string): void
    if self._embeddable then
      error("Embeddables only have columns, '" .. option .. "' is not supported", 3)
    end
  end

  local function addRelation(fieldName: string, kind: RelationKind, target: any, mappedBy: string?): EntityBuilder
    self:requireEntity("relations")
    self:requireNewField(fieldName)
    local targetName: string? = nil
    if target is string then
      targetName = target
    elseif type(target) == "table" and type(rawget(target, "__name")) == "string" then
      targetName = rawget(target, "__name") as string
    end

    if targetName == nil then
      error("Relation '" .. fieldName .. "' needs a target class or class name", 3)
    end

    local relation = new RelationMetadata(fieldName, kind, targetName)
    relation.mappedBy = mappedBy
    table.insert(self._relations, relation)
    self._currentRelation = relation
    self._currentEmbedded = nil
    return self
  end

  --- Adds a column for the given field. The type is a type name like "string", "integer" or "Uuid", a registered class, an enum table or a ColumnType instance.
  --- The column name defaults to the field name in snake case.
  function column(fieldName: string, typeRef: any, nullable: boolean = false): EntityBuilder
    if typeRef == nil then
      error("Column '" .. fieldName .. "' needs a type", 2)
    end

    self:requireNewField(fieldName)
    local columnMetadata = new ColumnMetadata(fieldName, toSnakeCase(fieldName))
    columnMetadata.typeRef = typeRef
    columnMetadata.nullable = nullable
    table.insert(self._columns, columnMetadata)
    self._current = columnMetadata
    self._currentRelation = nil
    self._currentEmbedded = nil
    return self
  end

  --- Marks the last column as primary key. The strategy is "auto" or "none".
  function id(strategy: string = "auto"): EntityBuilder
    self:requireEntity("id")
    local current = self:requireColumn("id")
    if strategy ~= GenerationStrategy.Auto and strategy ~= GenerationStrategy.None then
      error("Unknown id strategy '" .. strategy .. "'", 2)
    end

    current.isId = true
    current.generation = strategy as GenerationStrategy
    return self
  end

  --- Overrides the database name of the last column.
  function name(columnName: string): EntityBuilder
    self:requireColumn("name").columnName = columnName
    return self
  end

  --- Sets the maximum length of the last column.
  function length(maxLength: number): EntityBuilder
    self:requireColumn("length").length = maxLength
    return self
  end

  --- Sets the precision and scale of the last column.
  function precision(digits: number, scale: number? = nil): EntityBuilder
    local current = self:requireColumn("precision")
    current.precision = digits
    current.scale = scale
    return self
  end

  --- Adds or removes a unique constraint on the last column.
  function unique(flag: boolean = true): EntityBuilder
    self:requireColumn("unique").unique = flag
    return self
  end

  --- Defines whether the last column, the foreign key of the last to-one relation or the last embedded field accepts nil.
  function nullable(flag: boolean = true): EntityBuilder
    local embedded = self._currentEmbedded
    if embedded ~= nil then
      embedded.nullable = flag
      return self
    end

    local relation = self._currentRelation
    if relation ~= nil then
      relation.nullable = flag
      return self
    end

    self:requireColumn("nullable").nullable = flag
    return self
  end

  --- Lets the class created by this builder extend the given class, so it inherits its mapping. Classes passed as table already
  --- have their parent and do not need it.
  function extends(parentClass: any): EntityBuilder
    if type(parentClass) ~= "table" then
      error("extends needs a class table", 2)
    end

    if not self._createdClass then
      if MetadataRegistry.parentClassOf(self._entityClass) ~= parentClass then
        error("'" .. self._className .. "' was passed as class table, set its parent class there instead", 2)
      end

      return self
    end

    setmetatable(self._entityClass, { __index = parentClass })
    return self
  end

  --- Makes this entity the root of a single table inheritance hierarchy. The classes extending it are stored in the same table, the
  --- discriminator column, "type" by default, tells them apart. Only "single" is supported as kind.
  function inheritance(kind: string = "single", columnName: string = "type", length: number = 32): EntityBuilder
    self:requireEntity("inheritance")
    if string.lower(kind) ~= "single" then
      error("Only single table inheritance is supported, not '" .. kind .. "'", 2)
    end

    self._inheritance = { columnName = columnName, length = length }
    return self
  end

  --- Sets the value stored in the discriminator column for instances of exactly this class. Defaults to the class name in snake case
  --- without a Model suffix, like "car" for CarModel.
  function discriminatorValue(value: string): EntityBuilder
    self._discriminatorValue = value
    return self
  end

  --- Marks the root of an inheritance hierarchy as abstract. It gets no discriminator value and only its subclasses can be persisted.
  function abstract(): EntityBuilder
    self._abstract = true
    return self
  end

  --- Adds a field holding an object of an embeddable class, given as class table or class name. Its columns are stored in the entity table
  --- with the prefix in front of their names, which defaults to the field name in snake case followed by an underscore. Pass "" for none.
  --- Without nullable the field always holds an object, an empty one is created if it is nil.
  function embedded(fieldName: string, target: any, prefix: string? = nil): EntityBuilder
    self:requireEntity("embedded")
    self:requireNewField(fieldName)
    local entry = { fieldName = fieldName, target = target, prefix = prefix, nullable = false }
    table.insert(self._embeddeds, entry)
    self._current = nil
    self._currentRelation = nil
    self._currentEmbedded = entry
    return self
  end

  --- Adds a ManyToOne relation, which stores the id of the target in a foreign key column. The foreign key is nullable by default.
  function manyToOne(fieldName: string, target: any): EntityBuilder
    return self:addRelation(fieldName, RelationKind.ManyToOne, target, nil)
  end

  --- Adds a OneToOne relation. Without mappedBy it is the owning side with a unique foreign key column, with mappedBy the inverse side.
  function oneToOne(fieldName: string, target: any, mappedBy: string? = nil): EntityBuilder
    return self:addRelation(fieldName, RelationKind.OneToOne, target, mappedBy)
  end

  --- Adds a OneToMany relation, the inverse side of the ManyToOne relation named by mappedBy on the target.
  function oneToMany(fieldName: string, target: any, mappedBy: string): EntityBuilder
    return self:addRelation(fieldName, RelationKind.OneToMany, target, mappedBy)
  end

  --- Adds a ManyToMany relation. Without mappedBy it is the owning side with a join table, with mappedBy the inverse side.
  function manyToMany(fieldName: string, target: any, mappedBy: string? = nil): EntityBuilder
    return self:addRelation(fieldName, RelationKind.ManyToMany, target, mappedBy)
  end

  --- Names the field of the inverse side on the target. Only needed when it cannot be found by its mappedBy.
  function inversedBy(fieldName: string): EntityBuilder
    self:requireRelation("inversedBy").inversedBy = fieldName
    return self
  end

  --- Overrides the foreign key column of the last to-one relation.
  function joinColumn(columnName: string): EntityBuilder
    self:requireRelation("joinColumn").joinColumnName = columnName
    return self
  end

  --- Sets the ON DELETE action of the foreign key of the last relation, for example "CASCADE" or "SET NULL".
  function onDelete(action: string): EntityBuilder
    local upper = string.upper(action)
    if upper ~= "CASCADE" and upper ~= "SET NULL" and upper ~= "RESTRICT" and upper ~= "NO ACTION" then
      error("Unknown ON DELETE action '" .. action .. "'", 2)
    end

    self:requireRelation("onDelete").onDelete = upper
    return self
  end

  --- Overrides the join table and its columns of the last ManyToMany relation.
  function joinTable(tableName: string, joinColumn: string? = nil, inverseJoinColumn: string? = nil): EntityBuilder
    local relation = self:requireRelation("joinTable")
    relation.joinTableName = tableName
    relation.joinTableColumn = joinColumn
    relation.inverseJoinTableColumn = inverseJoinColumn
    return self
  end

  --- Sets the operations passed on to the related entities of the last relation: "persist", "remove" or both like "persist, remove", or "all".
  function cascade(operations: string): EntityBuilder
    local relation = self:requireRelation("cascade")
    for operation in string.gmatch(string.lower(operations), "[%a]+") do
      if operation == "persist" then
        relation.cascadePersist = true
      elseif operation == "remove" then
        relation.cascadeRemove = true
      elseif operation == "all" then
        relation.cascadePersist = true
        relation.cascadeRemove = true
      else
        error("Unknown cascade operation '" .. operation .. "'", 2)
      end
    end

    return self
  end

  --- Sets whether the last relation is loaded lazily, only when requested with the with option or load, or eagerly by every query
  --- that loads the entity. Eager relations referring back to a relation that is being loaded are skipped.
  function fetch(mode: string): EntityBuilder
    local relation = self:requireRelation("fetch")
    local normalized = string.lower(mode)
    if normalized ~= "lazy" and normalized ~= "eager" then
      error("Unknown fetch mode '" .. mode .. "', use \"lazy\" or \"eager\"", 2)
    end

    relation.fetch = normalized
    return self
  end

  --- Deletes related entities that are removed from the last relation, from the collection of a OneToMany relation or by replacing
  --- the value of an owning OneToOne relation.
  function orphanRemoval(flag: boolean = true): EntityBuilder
    local relation = self:requireRelation("orphanRemoval")
    if relation.kind ~= RelationKind.OneToMany and not (relation.kind == RelationKind.OneToOne and relation.mappedBy == nil) then
      error("orphanRemoval is only supported for OneToMany and owning OneToOne relations", 2)
    end

    relation.orphanRemoval = flag
    return self
  end

  --- Sets the order of the loaded items of the last to-many relation, for example orderBy("level DESC", "username").
  function orderBy(...entries: string): EntityBuilder
    self:requireRelation("orderBy").orderBy = { ... }
    return self
  end

  --- Marks the last column as deletion time. Removing such an entity sets the column instead of deleting the row, and queries skip rows where it is set.
  function softDelete(): EntityBuilder
    local current = self:requireColumn("softDelete")
    current.isSoftDelete = true
    current.nullable = true
    return self
  end

  --- Marks the last column as version number for optimistic locking. It has to be an integer column. Every update increments it and
  --- only succeeds if the row still has the version the entity was loaded with, so concurrent changes fail instead of overwriting each other.
  function version(): EntityBuilder
    local current = self:requireColumn("version")
    if current.typeRef ~= "integer" and current.typeRef ~= "bigint" then
      error("The version column '" .. current.fieldName .. "' has to be an integer column", 2)
    end

    current.isVersion = true
    current.nullable = false
    return self
  end

  --- Sets the currency code of the last column, for money columns.
  function currency(code: string): EntityBuilder
    self:requireColumn("currency").currency = code
    return self
  end

  --- Adds an index over the given fields, for example index({ "guild", "rank" }). Relations are indexed by their foreign key column.
  function index(fields: string[], name: string? = nil): EntityBuilder
    return self:addIndex(fields, false, name)
  end

  --- Adds a unique constraint over the given fields, for example uniqueConstraint({ "guild", "name" }).
  function uniqueConstraint(fields: string[], name: string? = nil): EntityBuilder
    return self:addIndex(fields, true, name)
  end

  local function addIndex(fields: string[], unique: boolean, name: string?): EntityBuilder
    self:requireEntity("indexes")
    if type(fields) ~= "table" or #fields == 0 then
      error("An index needs at least one field", 3)
    end

    local copy: string[] = {}
    for _, fieldName in ipairs(fields) do
      table.insert(copy, tostring(fieldName))
    end

    table.insert(self._indexes, new IndexMetadata(copy, unique, name))
    return self
  end

  --- Resolves all column types, registers the metadata and returns the class table.
  function build(): any
    if self._embeddable then
      return self:buildEmbeddable()
    end

    local packageName = getCallingPackage()

    local parent = MetadataRegistry.findParent(self._entityClass)
    local columns: ColumnMetadata[] = {}
    local relations: RelationMetadata[] = {}
    local indexes: IndexMetadata[] = {}
    local inheritanceRoot: EntityMetadata? = nil
    if parent ~= nil and not parent.isMappedSuperclass then
      local root = parent:getRootMetadata()
      if root.discriminatorColumn == nil then
        error("'" .. self._className .. "' extends the entity '" .. parent.className .. "', which needs :inheritance() or @Inheritance to be extended", 2)
      end

      if self._inheritance ~= nil then
        error("'" .. self._className .. "' is part of the inheritance hierarchy of '" .. root.className .. "' and cannot start its own", 2)
      end

      if self._tableName ~= nil and self._tableName ~= root.tableName then
        error("'" .. self._className .. "' is stored in the table of '" .. root.className .. "' and cannot have its own table name", 2)
      end

      inheritanceRoot = root
    end

    if parent ~= nil then
      for index = 1, #parent.indexes do
        table.insert(indexes, parent.indexes[index])
      end

      for index = 1, #parent.columns do
        table.insert(columns, parent.columns[index])
      end

      for index = 1, #parent.relations do
        table.insert(relations, parent.relations[index]:copy())
      end
    end

    local embeddeds: EmbeddedMetadata[] = {}
    if parent ~= nil then
      for _, embedded in ipairs(parent.embeddeds) do
        table.insert(embeddeds, embedded)
      end
    end

    for _, entry in ipairs(self._embeddeds) do
      local embeddable = MetadataRegistry.getEmbeddable(entry.target, packageName)
      if embeddable == nil then
        error("The embedded field '" .. entry.fieldName .. "' of '" .. self._className .. "' needs an embeddable class that was built before", 2)
      end

      for _, existing in ipairs(embeddeds) do
        if existing.fieldName == entry.fieldName then
          error("Embedded field '" .. entry.fieldName .. "' of '" .. self._className .. "' is already mapped by a parent class", 2)
        end
      end

      table.insert(embeddeds, new EmbeddedMetadata(entry.fieldName, embeddable, entry.prefix ?? (toSnakeCase(entry.fieldName) .. "_"), entry.nullable))
    end

    for index = 1, #self._relations do
      local own = self._relations[index]
      for existing = 1, #relations do
        if relations[existing].fieldName == own.fieldName then
          error("Relation '" .. own.fieldName .. "' of '" .. self._className .. "' is already mapped by a parent class", 2)
        end
      end

      for existing = 1, #columns do
        if columns[existing].fieldName == own.fieldName then
          error("Relation '" .. own.fieldName .. "' of '" .. self._className .. "' is already mapped as column by a parent class", 2)
        end
      end

      if own.kind == RelationKind.OneToMany and own.mappedBy == nil then
        error("The OneToMany relation '" .. own.fieldName .. "' needs mappedBy", 2)
      end

      table.insert(relations, own)
    end

    for index = 1, #self._columns do
      local own = self._columns[index]
      for existing = 1, #columns do
        if columns[existing].fieldName == own.fieldName then
          error("Column '" .. own.fieldName .. "' of '" .. self._className .. "' is already mapped by a parent class", 2)
        end
      end

      own.columnType = TypeRegistry.resolve(own)
      if own.isId and own.generation == GenerationStrategy.Auto and own.typeRef ~= "Uuid" and own.typeRef ~= "integer" and own.typeRef ~= "bigint" then
        own.generation = GenerationStrategy.None
      end

      table.insert(columns, own)
    end

    local idCount = 0
    for index = 1, #columns do
      if columns[index].isId then
        idCount = idCount + 1
      end
    end

    local versionCount = 0
    for index = 1, #columns do
      if columns[index].isVersion then
        versionCount = versionCount + 1
      end
    end

    if versionCount > 1 then
      error("Entity '" .. self._className .. "' has more than one version column", 2)
    end

    if idCount > 1 then
      error("Entity '" .. self._className .. "' has more than one id column", 2)
    elseif idCount == 0 and not self._mappedSuperclass then
      error("Entity '" .. self._className .. "' has no id column, mark one with @Id or :id()", 2)
    end

    local ordered: ColumnMetadata[] = {}
    for index = 1, #columns do
      if columns[index].isId then
        table.insert(ordered, columns[index])
      end
    end

    for index = 1, #columns do
      if not columns[index].isId then
        table.insert(ordered, columns[index])
      end
    end

    columns = ordered
    local tableName = self._tableName ?? deriveTableName(self._className)
    if inheritanceRoot ~= nil then
      tableName = inheritanceRoot.tableName
    end

    for _, own in ipairs(self._indexes) do
      for _, fieldName in ipairs(own.fields) do
        local known = false
        for _, column in ipairs(columns) do
          if column.fieldName == fieldName then
            known = true
          end
        end

        local head, rest = string.match(fieldName, "^([^%.]+)%.(.+)$")
        for _, embedded in ipairs(embeddeds) do
          for _, column in ipairs(embedded.columns) do
            if embedded.fieldName == head and column.property == rest then
              known = true
            end
          end
        end

        for _, relation in ipairs(relations) do
          if relation.fieldName == fieldName then
            if not relation:hasJoinColumn() then
              error("The index of '" .. self._className .. "' references the relation '" .. fieldName .. "', which has no foreign key column", 2)
            end

            known = true
          end
        end

        if not known then
          error("The index of '" .. self._className .. "' references the unknown field '" .. fieldName .. "'", 2)
        end
      end

      table.insert(indexes, own)
    end

    local metadata = new EntityMetadata(self._entityClass, self._className, tableName, columns, relations, indexes, self._mappedSuperclass, parent, embeddeds)
    metadata.packageName = packageName
    local columnNames: { [string]: boolean } = {}
    for _, column in ipairs(metadata:getTableColumns()) do
      if columnNames[column.columnName] then
        error("The column '" .. column.columnName .. "' of '" .. self._className .. "' is mapped twice, check the prefixes of embedded fields", 2)
      end

      columnNames[column.columnName] = true
    end

    local inheritance = self._inheritance
    if inheritance ~= nil then
      local discriminator = new ColumnMetadata("__discriminator", inheritance.columnName)
      discriminator.typeRef = "string"
      discriminator.length = inheritance.length
      discriminator.isDiscriminator = true
      discriminator.columnType = TypeRegistry.resolve(discriminator)
      if metadata:getColumnByName(discriminator.columnName) ~= nil then
        error("The discriminator column '" .. discriminator.columnName .. "' of '" .. self._className .. "' is already mapped", 2)
      end

      metadata:enableSingleTableInheritance(discriminator, self:resolveDiscriminatorValue())
    elseif inheritanceRoot ~= nil then
      metadata.discriminatorValue = self:resolveDiscriminatorValue()
      inheritanceRoot:addSubclass(metadata)
    elseif self._discriminatorValue ~= nil or self._abstract then
      error("'" .. self._className .. "' is not part of an inheritance hierarchy, discriminatorValue and abstract need :inheritance() on the root", 2)
    end

    MetadataRegistry.register(metadata)
    return self._entityClass
  end

  local function resolveDiscriminatorValue(): string?
    if self._abstract then
      return nil
    end

    return self._discriminatorValue ?? deriveTableName(self._className)
  end

  local function buildEmbeddable(): any
    if #self._columns == 0 then
      error("Embeddable '" .. self._className .. "' has no columns", 3)
    end

    for _, column in ipairs(self._columns) do
      if column.isSoftDelete or column.isVersion then
        error("The column '" .. column.fieldName .. "' of the embeddable '" .. self._className .. "' cannot be a soft delete or version column", 3)
      end

      column.columnType = TypeRegistry.resolve(column)
    end

    local embeddable = new EmbeddableMetadata(self._entityClass, self._className, self._columns)
    embeddable.packageName = getCallingPackage()
    MetadataRegistry.registerEmbeddable(embeddable)
    return self._entityClass
  end
end
