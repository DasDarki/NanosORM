import { ColumnMetadata, EntityMetadata, GenerationStrategy, RelationMetadata, RelationKind, MetadataRegistry } from "./Metadata"
import { Connection, QueryParams } from "../dbal/Connection"
import { Expression, ExpressionKind, Aggregate } from "./Expression"

local ROOT_ALIAS = "t0"

--- Builds the SQL for one entity class and reads its rows.
---
--- Criteria are tables from field name to value. A plain array of values matches any of them, an Expr condition like Expr.gt(5) or Expr.isNull()
--- compares differently, and array entries like Expr.anyOf({ ... }, { ... }) combine whole criteria tables. Owning to-one relations can be
--- compared with entities or ids, for example { owner = user } or { owner = Expr.isIn(users) }. Fields of embedded objects are named by
--- their path, for example { ["address.city"] = "Berlin" }.
--- Options are tables with the optional keys orderBy (an array like { "createdAt DESC", "username" }), limit, offset and withDeleted.
export class EntityPersister

  local _metadata: EntityMetadata
  local _connection: Connection

  constructor(metadata: EntityMetadata, connection: Connection)
    self._metadata = metadata
    self._connection = connection
  end

  --- Returns the metadata of the persisted entity class.
  function getMetadata(): EntityMetadata
    return self._metadata
  end

  --- Returns the alias of the main table in SELECT statements.
  function getRootAlias(): string
    return ROOT_ALIAS
  end

  --- Returns whether the id is generated by the database with auto increment.
  function hasIncrementId(): boolean
    local idColumn = self._metadata.idColumn
    return idColumn ~= nil and idColumn.generation == GenerationStrategy.Auto and (idColumn.typeRef == "integer" or idColumn.typeRef == "bigint")
  end

  --- Returns the columns, the columns of embedded fields and the foreign key columns written to the table.
  function getWritableColumns(): ColumnMetadata[]
    local result: ColumnMetadata[] = {}
    for _, column in ipairs(self._metadata:getTableColumns()) do
      table.insert(result, column)
    end

    local joinColumns = self._metadata:getJoinColumns()
    for index = 1, #joinColumns do
      table.insert(result, joinColumns[index])
    end

    return result
  end

  --- Converts a value of a column into a query value. Entities given for foreign key columns are converted into their id.
  function toDatabaseValue(column: ColumnMetadata, value: any): any
    local resolved = self:entityToId(value)
    if resolved == nil then
      return nil
    end

    return column:getColumnType():toDatabase(resolved, self._connection:getPlatform())
  end

  --- Converts an id given as value object, string or number into the value object of the id column.
  function normalizeId(id: any): any
    if id == nil or type(id) == "table" then
      return id
    end

    local converted = self._metadata:getIdColumn():getColumnType():fromDatabase(id, self._connection:getPlatform())
    return converted ?? id
  end

  --- Returns a string key that identifies the entity with the given id.
  function identityKey(id: any): string
    return tostring(self:toDatabaseValue(self._metadata:getIdColumn(), self:normalizeId(id)))
  end

  --- Quotes a column of a table alias.
  function qualify(alias: string, columnName: string): string
    return alias .. "." .. self._connection:quote(columnName)
  end

  --- Returns the select list of all columns of this entity under the given alias. Each column is returned as alias_column.
  function getSelectColumns(alias: string): string[]
    local result: string[] = {}
    local columns = self:getWritableColumns()
    if self._metadata:isInheritanceMember() then
      columns = self._metadata:getHierarchyColumns()
    end

    for index = 1, #columns do
      local columnName = columns[index].columnName
      table.insert(result, self:qualify(alias, columnName) .. " AS " .. self._connection:quote(alias .. "_" .. columnName))
    end

    return result
  end

  --- Reads the columns of this entity from a row selected with getSelectColumns, or from a row keyed by the plain column names without alias.
  --- Returns nil if the row holds no entity under the alias,
  --- otherwise a table with the id, the identity key, the converted column values and the target ids of the foreign keys.
  function readRow(row: any, alias: string?): any
    local platform = self._connection:getPlatform()
    local idColumn = self._metadata:getIdColumn()
    local rawId = row[self:rowKey(alias, idColumn.columnName)]
    if rawId == nil then
      return nil
    end

    local values: { [string]: any } = {}
    for index = 1, #self._metadata.columns do
      local column = self._metadata.columns[index]
      local raw = row[self:rowKey(alias, column.columnName)]
      if raw ~= nil then
        values[column.fieldName] = column:getColumnType():fromDatabase(raw, platform)
      end
    end

    for _, embedded in ipairs(self._metadata.embeddeds) do
      local object: any = nil
      for _, column in ipairs(embedded.columns) do
        local raw = row[self:rowKey(alias, column.columnName)]
        if raw ~= nil then
          object = object ?? embedded:createInstance()
          rawset(object, column.property, column:getColumnType():fromDatabase(raw, platform))
        end
      end

      if object == nil and not embedded.nullable then
        object = embedded:createInstance()
      end

      values[embedded.fieldName] = object
    end

    local foreignKeys: { [string]: any } = {}
    for index = 1, #self._metadata.relations do
      local relation = self._metadata.relations[index]
      if relation:hasJoinColumn() then
        local column = relation:getJoinColumn()
        local raw = row[self:rowKey(alias, column.columnName)]
        if raw ~= nil then
          foreignKeys[relation.fieldName] = column:getColumnType():fromDatabase(raw, platform) ?? raw
        end
      end
    end

    local id = values[idColumn.fieldName] ?? self:normalizeId(rawId)
    return { id = id, key = self:identityKey(id), values = values, foreignKeys = foreignKeys }
  end

  --- Builds an INSERT for the given field values. Auto increment ids without value are left out and returned by the statement where the platform supports it.
  function buildInsert(values: { [string]: any }): (string, QueryParams)
    local params = self._connection:createParams()
    local columnNames: string[] = {}
    local placeholders: string[] = {}
    local idColumn = self._metadata.idColumn
    local skipId = self:hasIncrementId() and idColumn ~= nil and values[idColumn.fieldName] == nil
    local columns = self:getWritableColumns()
    for index = 1, #columns do
      local column = columns[index]
      if not (skipId and column.isId) then
        table.insert(columnNames, self._connection:quote(column.columnName))
        table.insert(placeholders, params:add(self:toDatabaseValue(column, self:valueOf(values, column))))
      end
    end

    local sql = "INSERT INTO " .. self:quotedTable() .. " (" .. table.concat(columnNames, ", ") .. ") VALUES (" .. table.concat(placeholders, ", ") .. ")"
    if skipId and idColumn ~= nil and self._connection:getPlatform():supportsReturning() then
      sql = sql .. " RETURNING " .. self._connection:quote(idColumn.columnName)
    end

    return sql, params
  end

  --- Builds one INSERT for several entities whose ids are known, like INSERT INTO t (...) VALUES (...), (...).
  function buildInsertBatch(rows: { [string]: any }[]): (string, QueryParams)
    local params = self._connection:createParams()
    local columns = self:getWritableColumns()
    local columnNames: string[] = {}
    for _, column in ipairs(columns) do
      table.insert(columnNames, self._connection:quote(column.columnName))
    end

    local tuples: string[] = {}
    for _, values in ipairs(rows) do
      local placeholders: string[] = {}
      for _, column in ipairs(columns) do
        table.insert(placeholders, params:add(self:toDatabaseValue(column, self:valueOf(values, column))))
      end

      table.insert(tuples, "(" .. table.concat(placeholders, ", ") .. ")")
    end

    return "INSERT INTO " .. self:quotedTable() .. " (" .. table.concat(columnNames, ", ") .. ") VALUES " .. table.concat(tuples, ", "), params
  end

  --- Returns how many rows fit into one batch INSERT without exceeding the parameter limits of the databases.
  function getBatchSize(): number
    return math.max(1, math.min(500, 900 // #self:getWritableColumns()))
  end

  --- Builds an UPDATE of the changed columns and foreign keys for the entity with the given id. Returns an empty string if nothing has to be written.
  --- With a version column the version is incremented and the row only matches while it still has the expected version.
  function buildUpdate(changes: { [string]: { old: any, new: any } }, id: any, expectedVersion: number? = nil): (string, QueryParams)
    local params = self._connection:createParams()
    local assignments: string[] = {}
    local columns = self:getWritableColumns()
    for index = 1, #columns do
      local column = columns[index]
      local embedded = column.embedded
      local change = changes[embedded ~= nil and embedded.fieldName or column.fieldName]
      if change ~= nil and not column.isId and not column.isVersion and not self:isUnchangedEmbeddedColumn(column, change) then
        local value = change.new
        if embedded ~= nil then
          value = embedded:readValue(change.new, column)
        end

        table.insert(assignments, self._connection:quote(column.columnName) .. " = " .. params:add(self:toDatabaseValue(column, value)))
      end
    end

    if #assignments == 0 then
      return "", params
    end

    local versionColumn = self._metadata.versionColumn
    if versionColumn ~= nil then
      local quoted = self._connection:quote(versionColumn.columnName)
      table.insert(assignments, quoted .. " = " .. quoted .. " + 1")
    end

    local sql = "UPDATE " .. self:quotedTable() .. " SET " .. table.concat(assignments, ", ") .. " WHERE " .. self:idCondition(nil, id, params) .. self:versionCondition(expectedVersion, params)
    return sql, params
  end

  --- Builds a DELETE for the entity with the given id. With a version column the row only matches while it still has the expected version.
  function buildDelete(id: any, expectedVersion: number? = nil): (string, QueryParams)
    local params = self._connection:createParams()
    return "DELETE FROM " .. self:quotedTable() .. " WHERE " .. self:idCondition(nil, id, params) .. self:versionCondition(expectedVersion, params), params
  end

  --- Builds a SELECT for all entities matching the criteria. The extra table may add joins (a SQL string), columns (an array),
  --- where (a function receiving the parameters and returning an additional condition) and aliases (to-one joins already in joins,
  --- from "alias.field" to their alias, which criteria paths reuse instead of joining the same relation again).
  function buildSelect(criteria: any, options: any, extra: any = nil): (string, QueryParams)
    local params = self._connection:createParams()
    local context = self:createContext()
    if extra ~= nil and extra.aliases ~= nil then
      for key, alias in pairs(extra.aliases) do
        context.aliases[key] = alias
      end
    end

    local columns = self:getSelectColumns(ROOT_ALIAS)
    if extra ~= nil and extra.columns ~= nil then
      for _, column in ipairs(extra.columns) do
        table.insert(columns, column)
      end
    end

    local where = self:whereClause(criteria, options, params, extra, context)
    local order = ""
    if options ~= nil and options.orderBy ~= nil then
      local orderParts: string[] = {}
      for _, entry in ipairs(options.orderBy) do
        table.insert(orderParts, self:orderPart(tostring(entry), context))
      end

      if #orderParts > 0 then
        order = " ORDER BY " .. table.concat(orderParts, ", ")
      end
    end

    local sql = "SELECT " .. table.concat(columns, ", ") .. " FROM " .. self:quotedTable() .. " " .. ROOT_ALIAS
    if extra ~= nil and extra.joins ~= nil and extra.joins ~= "" then
      sql = sql .. " " .. extra.joins
    end

    sql = sql .. self:joinsOf(context) .. where .. order
    if options ~= nil then
      sql = sql .. self._connection:getPlatform():getLimitSql(tonumber(options.limit), tonumber(options.offset))
    end

    return sql, params
  end

  --- Builds a SELECT COUNT for all entities matching the criteria.
  function buildCount(criteria: any, options: any): (string, QueryParams)
    local params = self._connection:createParams()
    local context = self:createContext()
    local where = self:whereClause(criteria, options, params, nil, context)
    return "SELECT COUNT(*) AS " .. self._connection:quote("count") .. " FROM " .. self:quotedTable() .. " " .. ROOT_ALIAS .. self:joinsOf(context) .. where, params
  end

  --- Builds a SELECT of aggregate functions and fields. The spec has the keys select (a table from result alias to a field path or an
  --- Agg function), where (criteria), groupBy (field paths or selected aliases), having (a table from selected alias to value or Expr),
  --- orderBy (selected aliases or field paths with direction), limit, offset and withDeleted. Without groupBy the rows are grouped by the
  --- selected fields if aggregates are selected as well. Returns the SQL, the parameters and how to read the selected aliases.
  function buildAggregate(spec: any): (string, QueryParams, any[])
    if type(spec) ~= "table" or type(spec.select) ~= "table" then
      error("An aggregate query needs a select table from alias to field path or Agg function", 3)
    end

    local params = self._connection:createParams()
    local context = self:createContext()
    local outputs: any[] = {}
    local byAlias: { [string]: any } = {}
    local aliases: string[] = {}
    for alias, _ in pairs(spec.select) do
      if type(alias) ~= "string" then
        error("The keys of the select table are the result aliases and have to be strings", 3)
      end

      table.insert(aliases, alias as string)
    end

    table.sort(aliases)
    local selectParts: string[] = {}
    local plainFields: string[] = {}
    local hasAggregate = false
    for _, alias in ipairs(aliases) do
      local entry = spec.select[alias]
      local output: any = { alias = alias }
      if Aggregate.isAggregate(entry) then
        local aggregate = entry as Aggregate
        local field = aggregate.field
        local argument = "*"
        if field ~= nil then
          local resolved = self:resolvePath(field, context)
          output.column = resolved.column
          argument = (aggregate.distinct and "DISTINCT " or "") .. resolved.quoted
        end

        output.func = aggregate.func
        output.sql = aggregate.func .. "(" .. argument .. ")"
        hasAggregate = true
      elseif type(entry) == "string" then
        local resolved = self:resolvePath(entry, context)
        output.column = resolved.column
        output.relation = resolved.relation
        output.sql = resolved.quoted
        table.insert(plainFields, output.sql)
      else
        error("The select entry '" .. alias .. "' has to be a field path or an Agg function", 3)
      end

      byAlias[alias] = output
      table.insert(outputs, output)
      table.insert(selectParts, output.sql .. " AS " .. self._connection:quote(alias))
    end

    local where = self:whereClause(spec.where, spec, params, nil, context)
    local groupParts: string[] = {}
    if spec.groupBy ~= nil then
      for _, entry in ipairs(spec.groupBy) do
        local output = byAlias[tostring(entry)]
        if output ~= nil and output.func == nil then
          table.insert(groupParts, output.sql)
        else
          table.insert(groupParts, self:resolvePath(tostring(entry), context).quoted)
        end
      end
    elseif hasAggregate then
      groupParts = plainFields
    end

    local havingParts: string[] = {}
    if spec.having ~= nil then
      local keys: string[] = {}
      for key, _ in pairs(spec.having) do
        table.insert(keys, tostring(key))
      end

      table.sort(keys)
      for _, alias in ipairs(keys) do
        local output = byAlias[alias]
        if output == nil then
          error("having references '" .. alias .. "', which is not selected", 3)
        end

        local column: ColumnMetadata? = output.column
        if output.func == "COUNT" or output.func == "SUM" or output.func == "AVG" then
          column = nil
        end

        table.insert(havingParts, self:condition(column, output.sql, spec.having[alias], params))
      end
    end

    local orderParts: string[] = {}
    for _, entry in ipairs(spec.orderBy ?? {}) do
      local name, direction = string.match(tostring(entry), "^%s*([%w_%.]+)%s*(%a*)%s*$")
      local output = name ~= nil and byAlias[name] or nil
      if output ~= nil then
        local upper = string.upper(direction ?? "")
        if upper ~= "" and upper ~= "ASC" and upper ~= "DESC" then
          error("Invalid order direction '" .. tostring(direction) .. "'", 3)
        end

        table.insert(orderParts, output.sql .. (upper == "DESC" and " DESC" or " ASC"))
      else
        table.insert(orderParts, self:orderPart(tostring(entry), context))
      end
    end

    local sql = "SELECT " .. table.concat(selectParts, ", ") .. " FROM " .. self:quotedTable() .. " " .. ROOT_ALIAS .. self:joinsOf(context) .. where
    if #groupParts > 0 then
      sql = sql .. " GROUP BY " .. table.concat(groupParts, ", ")
    end

    if #havingParts > 0 then
      sql = sql .. " HAVING " .. table.concat(havingParts, " AND ")
    end

    if #orderParts > 0 then
      sql = sql .. " ORDER BY " .. table.concat(orderParts, ", ")
    end

    sql = sql .. self._connection:getPlatform():getLimitSql(tonumber(spec.limit), tonumber(spec.offset))
    return sql, params, outputs
  end

  --- Reads a row of an aggregate query. Counts become integers, sums and averages numbers, fields and MIN or MAX of a field the type
  --- of the field. Owning to-one relations are read as the id of the target.
  function readAggregateRow(row: any, outputs: any[]): { [string]: any }
    local platform = self._connection:getPlatform()
    local result: { [string]: any } = {}
    for _, output in ipairs(outputs) do
      local raw = row[output.alias]
      if raw ~= nil then
        local func = output.func
        local column: ColumnMetadata? = output.column
        if func == "COUNT" then
          result[output.alias] = math.tointeger(tonumber(raw)) ?? tonumber(raw)
        elseif func == "SUM" or func == "AVG" then
          result[output.alias] = tonumber(raw) ?? raw
        elseif column ~= nil then
          result[output.alias] = column:getColumnType():fromDatabase(raw, platform) ?? raw
        else
          result[output.alias] = raw
        end
      end
    end

    return result
  end

  --- Builds the INSERT of a join table row for an owning ManyToMany relation of this entity.
  function buildJoinTableInsert(relation: RelationMetadata, ownerId: any, targetId: any): (string, QueryParams)
    local params = self._connection:createParams()
    local ownerColumn = self._connection:quote(relation:getOwningJoinTableColumn())
    local targetColumn = self._connection:quote(relation:getInverseJoinTableColumn())
    local sql = "INSERT INTO " .. self._connection:quote(relation:getJoinTableName()) .. " (" .. ownerColumn .. ", " .. targetColumn .. ") VALUES ("
      .. params:add(self:toDatabaseValue(self._metadata:getIdColumn(), ownerId)) .. ", "
      .. params:add(self:toDatabaseValue(relation:getTarget():getIdColumn(), targetId)) .. ")"
    return sql, params
  end

  --- Builds the DELETE of join table rows for an owning ManyToMany relation of this entity. Without a target id all rows of the owner are deleted.
  function buildJoinTableDelete(relation: RelationMetadata, ownerId: any, targetId: any = nil): (string, QueryParams)
    local params = self._connection:createParams()
    local sql = "DELETE FROM " .. self._connection:quote(relation:getJoinTableName()) .. " WHERE "
      .. self._connection:quote(relation:getOwningJoinTableColumn()) .. " = " .. params:add(self:toDatabaseValue(self._metadata:getIdColumn(), ownerId))
    if targetId ~= nil then
      sql = sql .. " AND " .. self._connection:quote(relation:getInverseJoinTableColumn()) .. " = " .. params:add(self:toDatabaseValue(relation:getTarget():getIdColumn(), targetId))
    end

    return sql, params
  end

  local function isUnchangedEmbeddedColumn(column: ColumnMetadata, change: { old: any, new: any }): boolean
    local embedded = column.embedded
    local snapshot = change.old
    if embedded == nil or snapshot == nil or change.new == nil then
      return false
    end

    local value = embedded:readValue(change.new, column)
    local internallyChanged = type(value) == "table" and type(value.isDirty) == "function" and value:isDirty() == true
    return snapshot[column.property] == value and not internallyChanged
  end

  local function discriminatorCondition(alias: string, params: QueryParams): string?
    local metadata = self._metadata
    local column = metadata.discriminatorColumn
    if column == nil or metadata:getRootMetadata() == metadata then
      return nil
    end

    local placeholders: string[] = {}
    for _, value in ipairs(metadata:getDiscriminatorValues()) do
      table.insert(placeholders, params:add(value))
    end

    if #placeholders == 0 then
      return "1 = 0"
    end

    return self:qualify(alias, column.columnName) .. " IN (" .. table.concat(placeholders, ", ") .. ")"
  end

  --- Returns the class stored in a row of the inheritance hierarchy, read from the discriminator column under the given alias.
  --- Entities outside of a hierarchy return their own metadata.
  function resolveRowMetadata(row: any, alias: string?): EntityMetadata
    local metadata = self._metadata
    local column = metadata.discriminatorColumn
    if column == nil then
      return metadata
    end

    local value = row[self:rowKey(alias, column.columnName)]
    if value == nil then
      return metadata
    end

    local resolved = metadata:getSubclassByDiscriminator(tostring(value))
    if resolved == nil then
      error("Unknown discriminator value '" .. tostring(value) .. "' in the table '" .. metadata.tableName .. "'", 0)
    end

    return resolved
  end

  local function rowKey(alias: string?, columnName: string): string
    if alias == nil then
      return columnName
    end

    return alias .. "_" .. columnName
  end

  local function resolvePath(path: string, context: any): any
    local metadata = self._metadata
    local alias = ROOT_ALIAS
    local fieldName = path
    while true do
      local head, rest = string.match(fieldName, "^([^%.]+)%.(.+)$")
      if head == nil or rest == nil or metadata:getEmbedded(head) ~= nil then
        break
      end

      local relation = metadata:getRelation(head)
      if relation == nil or not relation:isToOne() then
        error("'" .. metadata.className .. "' has no to-one relation '" .. head .. "' for '" .. path .. "'", 5)
      end

      alias = self:joinToOne(metadata, alias, relation, context)
      metadata = relation:getTarget()
      fieldName = rest
    end

    local column = metadata:getColumnOrJoinColumn(fieldName)
    if column == nil then
      error("'" .. metadata.className .. "' has no column or owning to-one relation for field '" .. fieldName .. "'", 5)
    end

    return { quoted = self:qualify(alias, column.columnName), column = column, relation = metadata:getRelation(fieldName) }
  end

  local function valueOf(values: { [string]: any }, column: ColumnMetadata): any
    if column.isDiscriminator then
      local value = self._metadata.discriminatorValue
      if value == nil then
        error("'" .. self._metadata.className .. "' is the abstract root of its inheritance hierarchy and cannot be persisted, persist a subclass", 0)
      end

      return value
    end

    local embedded = column.embedded
    if embedded ~= nil then
      return embedded:readValue(values[embedded.fieldName], column)
    end

    return values[column.fieldName]
  end

  local function entityToId(value: any): any
    if type(value) ~= "table" then
      return value
    end

    local metadata = MetadataRegistry.ofEntity(value)
    if metadata == nil then
      return value
    end

    local id = value[metadata:getIdColumn().fieldName]
    if id == nil then
      error("The referenced '" .. metadata.className .. "' has no id yet, persist and flush it first or use cascade persist", 4)
    end

    return id
  end

  local function versionCondition(expectedVersion: number?, params: QueryParams): string
    local versionColumn = self._metadata.versionColumn
    if versionColumn == nil or expectedVersion == nil then
      return ""
    end

    return " AND " .. self._connection:quote(versionColumn.columnName) .. " = " .. params:add(expectedVersion)
  end

  local function quotedTable(): string
    return self._connection:quote(self._metadata.tableName)
  end

  local function idCondition(alias: string?, id: any, params: QueryParams): string
    local idColumn = self._metadata:getIdColumn()
    local column = alias ~= nil and self:qualify(alias, idColumn.columnName) or self._connection:quote(idColumn.columnName)
    return column .. " = " .. params:add(self:toDatabaseValue(idColumn, self:normalizeId(id)))
  end

  local function createContext(): any
    return { joins = {}, aliases = {}, counter = { value = 0 } }
  end

  local function createSubContext(context: any): any
    return { joins = {}, aliases = {}, counter = context.counter }
  end

  local function nextAlias(context: any, prefix: string): string
    context.counter.value = context.counter.value + 1
    return prefix .. context.counter.value
  end

  local function joinsOf(context: any): string
    if #context.joins == 0 then
      return ""
    end

    return " " .. table.concat(context.joins, " ")
  end

  local function whereClause(criteria: any, options: any, params: QueryParams, extra: any, context: any): string
    local conditions: string[] = {}
    if criteria ~= nil then
      for _, condition in ipairs(self:criteriaConditions(self._metadata, ROOT_ALIAS, criteria, params, context)) do
        table.insert(conditions, condition)
      end
    end

    if extra ~= nil and extra.where ~= nil then
      table.insert(conditions, extra.where(params))
    end

    local softDeleteColumn = self._metadata.softDeleteColumn
    if softDeleteColumn ~= nil and not (options ~= nil and options.withDeleted == true) then
      table.insert(conditions, self:qualify(ROOT_ALIAS, softDeleteColumn.columnName) .. " IS NULL")
    end

    local discriminator = self:discriminatorCondition(ROOT_ALIAS, params)
    if discriminator ~= nil then
      table.insert(conditions, discriminator)
    end

    if #conditions == 0 then
      return ""
    end

    return " WHERE " .. table.concat(conditions, " AND ")
  end

  local function criteriaConditions(metadata: EntityMetadata, alias: string, criteria: any, params: QueryParams, context: any): string[]
    if type(criteria) ~= "table" or Expression.isExpression(criteria) then
      error("Criteria have to be a table from field name to value", 5)
    end

    local conditions: string[] = {}
    local fields: string[] = {}
    for key, _ in pairs(criteria) do
      if type(key) == "string" then
        table.insert(fields, key as string)
      elseif math.type(key) ~= "integer" then
        error("Invalid criteria key '" .. tostring(key) .. "'", 5)
      end
    end

    table.sort(fields)
    for _, path in ipairs(fields) do
      table.insert(conditions, self:pathCondition(metadata, alias, path, criteria[path], params, context))
    end

    for _, entry in ipairs(criteria) do
      table.insert(conditions, self:groupCondition(metadata, alias, entry, params, context))
    end

    return conditions
  end

  local function pathCondition(metadata: EntityMetadata, alias: string, path: string, value: any, params: QueryParams, context: any): string
    local head, rest = string.match(path, "^([^%.]+)%.(.+)$")
    if head == nil or rest == nil or metadata:getEmbedded(head) ~= nil then
      local column = metadata:getColumnOrJoinColumn(path)
      if column == nil then
        error("'" .. metadata.className .. "' has no column or owning to-one relation for field '" .. path .. "'", 6)
      end

      return self:condition(column, self:qualify(alias, column.columnName), value, params)
    end

    local relation = metadata:getRelation(head)
    if relation == nil then
      error("'" .. metadata.className .. "' has no relation '" .. head .. "' for the criteria path '" .. path .. "'", 6)
    end

    if relation:isToOne() then
      local joinAlias = self:joinToOne(metadata, alias, relation, context)
      return self:pathCondition(relation:getTarget(), joinAlias, rest, value, params, context)
    end

    return self:existsCondition(metadata, alias, relation, context, function(target: EntityMetadata, targetAlias: string, subContext: any): string
      return self:pathCondition(target, targetAlias, rest, value, params, subContext)
    end)
  end

  local function joinToOne(metadata: EntityMetadata, alias: string, relation: RelationMetadata, context: any): string
    local key = alias .. "." .. relation.fieldName
    local known = context.aliases[key]
    if known ~= nil then
      return known
    end

    local target = relation:getTarget()
    local joinAlias = self:nextAlias(context, "f")
    local condition = ""
    if relation:hasJoinColumn() then
      condition = self:qualify(joinAlias, target:getIdColumn().columnName) .. " = " .. self:qualify(alias, relation:getJoinColumn().columnName)
    else
      condition = self:qualify(joinAlias, relation:getMappedRelation():getJoinColumn().columnName) .. " = " .. self:qualify(alias, metadata:getIdColumn().columnName)
    end

    table.insert(context.joins, "LEFT JOIN " .. self._connection:quote(target.tableName) .. " " .. joinAlias .. " ON " .. condition)
    context.aliases[key] = joinAlias
    return joinAlias
  end

  local function existsCondition(metadata: EntityMetadata, alias: string, relation: RelationMetadata, context: any, inner: (EntityMetadata, string, any) -> string): string
    local target = relation:getTarget()
    local subContext = self:createSubContext(context)
    local targetAlias = self:nextAlias(subContext, "f")
    local fromClause = self._connection:quote(target.tableName) .. " " .. targetAlias
    local conditions: string[] = {}
    if relation.kind == RelationKind.OneToMany then
      table.insert(conditions, self:qualify(targetAlias, relation:getMappedRelation():getJoinColumn().columnName) .. " = " .. self:qualify(alias, metadata:getIdColumn().columnName))
    else
      local joinAlias = self:nextAlias(subContext, "j")
      fromClause = self._connection:quote(relation:getJoinTableName()) .. " " .. joinAlias .. " INNER JOIN " .. fromClause .. " ON "
        .. self:qualify(targetAlias, target:getIdColumn().columnName) .. " = " .. self:qualify(joinAlias, relation:getTargetJoinTableColumn())
      table.insert(conditions, self:qualify(joinAlias, relation:getSelfJoinTableColumn()) .. " = " .. self:qualify(alias, metadata:getIdColumn().columnName))
    end

    local softDeleteColumn = target.softDeleteColumn
    if softDeleteColumn ~= nil then
      table.insert(conditions, self:qualify(targetAlias, softDeleteColumn.columnName) .. " IS NULL")
    end

    table.insert(conditions, inner(target, targetAlias, subContext))
    return "EXISTS (SELECT 1 FROM " .. fromClause .. self:joinsOf(subContext) .. " WHERE " .. table.concat(conditions, " AND ") .. ")"
  end

  local function groupCondition(metadata: EntityMetadata, alias: string, expression: any, params: QueryParams, context: any): string
    if not Expression.isExpression(expression) or (expression.kind ~= ExpressionKind.Group and expression.kind ~= ExpressionKind.Not) then
      error("Array entries in criteria have to be Expr.anyOf, Expr.allOf or Expr.negate", 6)
    end

    local parts: string[] = {}
    for _, child in ipairs(expression.children) do
      local childConditions = self:criteriaConditions(metadata, alias, child, params, context)
      if #childConditions == 0 then
        table.insert(parts, "1 = 1")
      else
        table.insert(parts, "(" .. table.concat(childConditions, " AND ") .. ")")
      end
    end

    if expression.kind == ExpressionKind.Not then
      return "NOT " .. parts[1]
    end

    return "(" .. table.concat(parts, " " .. expression.comparison .. " ") .. ")"
  end

  local function condition(column: ColumnMetadata?, quoted: string, value: any, params: QueryParams): string
    if Expression.isExpression(value) then
      return self:expressionCondition(column, quoted, value as Expression, params)
    end

    if type(value) == "table" and getmetatable(value) == nil then
      return self:inCondition(column, quoted, value, false, params)
    end

    return quoted .. " = " .. self:parameter(column, value, params)
  end

  local function expressionCondition(column: ColumnMetadata?, quoted: string, expression: Expression, params: QueryParams): string
    local kind = expression.kind
    if kind == ExpressionKind.Compare then
      return quoted .. " " .. expression.comparison .. " " .. self:parameter(column, expression.values[1], params)
    elseif kind == ExpressionKind.In then
      return self:inCondition(column, quoted, expression.values, expression.negated, params)
    elseif kind == ExpressionKind.Null then
      return quoted .. (expression.negated and " IS NOT NULL" or " IS NULL")
    elseif kind == ExpressionKind.Between then
      return quoted .. " BETWEEN " .. self:parameter(column, expression.values[1], params) .. " AND " .. self:parameter(column, expression.values[2], params)
    elseif kind == ExpressionKind.Like then
      local pattern = params:add(tostring(expression.values[1]))
      return self._connection:getPlatform():getLikeSql(quoted, pattern, expression.negated, expression.caseInsensitive)
    end

    error("Expr.anyOf, Expr.allOf and Expr.negate combine criteria tables and cannot be used as value of " .. quoted, 6)
  end

  local function inCondition(column: ColumnMetadata?, quoted: string, values: any[], negated: boolean, params: QueryParams): string
    if #values == 0 then
      return negated and "1 = 1" or "1 = 0"
    end

    local placeholders: string[] = {}
    for _, item in ipairs(values) do
      table.insert(placeholders, self:parameter(column, item, params))
    end

    return quoted .. (negated and " NOT IN (" or " IN (") .. table.concat(placeholders, ", ") .. ")"
  end

  local function parameter(column: ColumnMetadata?, value: any, params: QueryParams): string
    if column == nil then
      return params:add(self:entityToId(value))
    end

    return params:add(self:toDatabaseValue(column, self:normalizeValue(column, self:entityToId(value))))
  end

  local function normalizeValue(column: ColumnMetadata, value: any): any
    if value == nil or type(value) == "table" then
      return value
    end

    local converted = column:getColumnType():fromDatabase(value, self._connection:getPlatform())
    return converted ?? value
  end

  local function orderPart(entry: string, context: any): string
    local path, direction = string.match(entry, "^%s*([%w_%.]+)%s*(%a*)%s*$")
    if path == nil then
      error("Invalid order entry '" .. entry .. "'", 4)
    end

    local upper = string.upper(direction ?? "")
    if upper ~= "" and upper ~= "ASC" and upper ~= "DESC" then
      error("Invalid order direction '" .. tostring(direction) .. "'", 4)
    end

    return self:resolvePath(path, context).quoted .. (upper == "DESC" and " DESC" or " ASC")
  end
end
