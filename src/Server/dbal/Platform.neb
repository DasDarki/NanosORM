import { DateTime, StringDateFormat, ISODateFormat } from "../types/DateTime"
import { TimeZone } from "../types/TimeZone"

local DATETIME_FORMAT = new StringDateFormat("yyyy-MM-dd HH:mm:ss.SSS", TimeZone.UTC)
local ISO_UTC_FORMAT = new ISODateFormat(TimeZone.UTC)

--- Describes the SQL dialect of a database. The base class generates standard SQL, subclasses override what their database does differently.
--- Column types ask the platform for type names and value conversions instead of checking the database engine themselves.
export abstract class Platform

  --- Returns the name of the platform, for example "mysql".
  abstract function getName(): string

  --- Quotes a table or column name.
  function quoteIdentifier(identifier: string): string
    return "\"" .. string.gsub(identifier, "\"", "\"\"") .. "\""
  end

  --- Returns the type of a string column with a maximum length.
  function getStringType(length: number): string
    return "VARCHAR(" .. length .. ")"
  end

  --- Returns the type of a string column with a fixed length.
  function getFixedStringType(length: number): string
    return "CHAR(" .. length .. ")"
  end

  --- Returns the type of a string column without length limit.
  function getTextType(): string
    return "TEXT"
  end

  --- Returns the type of a 32 bit integer column.
  function getIntegerType(): string
    return "INTEGER"
  end

  --- Returns the type of a 64 bit integer column.
  function getBigIntType(): string
    return "BIGINT"
  end

  --- Returns the type of a double precision floating point column.
  function getFloatType(): string
    return "DOUBLE PRECISION"
  end

  --- Returns the type of a boolean column.
  function getBooleanType(): string
    return "BOOLEAN"
  end

  --- Returns the type of an exact decimal column.
  function getDecimalType(precision: number, scale: number): string
    return "DECIMAL(" .. precision .. ", " .. scale .. ")"
  end

  --- Returns the type of a column holding a point in time with millisecond precision.
  function getDateTimeType(): string
    return "TIMESTAMP(3)"
  end

  --- Returns the type of a column holding a calendar date.
  function getDateType(): string
    return "DATE"
  end

  --- Returns the type of a column holding a UUID.
  function getUuidType(): string
    return "CHAR(36)"
  end

  --- Returns the type of a column holding JSON.
  function getJsonType(): string
    return "TEXT"
  end

  --- Converts a boolean into a query value.
  function convertBooleanToDatabase(value: boolean): any
    return value
  end

  --- Converts a point in time into a query value. It is always written in UTC.
  function convertDateTimeToDatabase(value: DateTime): any
    return value:toDateTime(TimeZone.UTC):toString(DATETIME_FORMAT)
  end

  --- Returns the column definition of an auto increment column, which may include the primary key.
  function getIdentityColumnSql(quotedName: string, sqlType: string): string
    return quotedName .. " " .. sqlType .. " GENERATED BY DEFAULT AS IDENTITY"
  end

  --- Returns whether getIdentityColumnSql already declares the primary key.
  function isIdentityPrimaryKeyInline(): boolean
    return false
  end

  --- Returns whether INSERT supports RETURNING to read generated values.
  function supportsReturning(): boolean
    return true
  end

  --- Returns the query that reads the last generated id when RETURNING is not supported. The id is returned in a column named "id".
  function getLastInsertIdSql(): string
    error("The platform '" .. self:getName() .. "' cannot read the last generated id", 2)
  end

  --- Returns the LIMIT and OFFSET clause including a leading space, or an empty string.
  function getLimitSql(limit: number?, offset: number?): string
    return self:buildLimitSql(limit, offset)
  end

  --- Builds the standard LIMIT and OFFSET clause, for subclasses that only change special cases.
  protected function buildLimitSql(limit: number?, offset: number?): string
    local sql = ""
    if limit ~= nil then
      sql = " LIMIT " .. math.floor(limit)
    end

    if offset ~= nil then
      sql = sql .. " OFFSET " .. math.floor(offset)
    end

    return sql
  end

  --- Returns a LIKE condition. Backslash escapes % and _ in the pattern. Case insensitive conditions ignore the case on every database.
  function getLikeSql(quotedColumn: string, pattern: string, negated: boolean, caseInsensitive: boolean): string
    local keyword = negated and " NOT LIKE " or " LIKE "
    if caseInsensitive then
      return "LOWER(" .. quotedColumn .. ")" .. keyword .. "LOWER(" .. pattern .. ")" .. self:getLikeEscapeSql()
    end

    return quotedColumn .. keyword .. pattern .. self:getLikeEscapeSql()
  end

  --- Returns the ESCAPE clause that makes backslash the escape character of LIKE patterns.
  function getLikeEscapeSql(): string
    return " ESCAPE '\\'"
  end

  --- Returns whether the database creates an index for every foreign key by itself.
  function createsForeignKeyIndexes(): boolean
    return false
  end

  --- Returns the statement that creates an index unless it exists.
  function getCreateIndexSql(indexName: string, quotedTable: string, quotedColumns: string[], unique: boolean = false): string
    local keyword = unique and "CREATE UNIQUE INDEX IF NOT EXISTS " or "CREATE INDEX IF NOT EXISTS "
    return keyword .. self:quoteIdentifier(indexName) .. " ON " .. quotedTable .. " (" .. table.concat(quotedColumns, ", ") .. ")"
  end

  --- Returns the query listing all tables of the current database. The table name is returned in a column named "name".
  function getListTablesSql(): string
    return "SELECT table_name AS name FROM information_schema.tables WHERE table_schema = current_schema()"
  end

  --- Returns the query listing the columns of a table, given as parameter placeholder. The column name is returned in a column named "name".
  function getListColumnsSql(tablePlaceholder: string): string
    return "SELECT column_name AS name FROM information_schema.columns WHERE table_schema = current_schema() AND table_name = " .. tablePlaceholder
  end

  --- Returns the query listing the index names of a table, given as parameter placeholder. The index name is returned in a column named "name".
  function getListIndexesSql(tablePlaceholder: string): string
    return "SELECT indexname AS name FROM pg_indexes WHERE schemaname = current_schema() AND tablename = " .. tablePlaceholder
  end

  --- Returns whether indexes are declared inside CREATE TABLE. Other platforms create them with separate statements.
  function supportsInlineIndexes(): boolean
    return false
  end

  --- Returns the index definition used inside CREATE TABLE.
  function getInlineIndexSql(indexName: string, quotedColumns: string[], unique: boolean): string
    return (unique and "UNIQUE INDEX " or "INDEX ") .. self:quoteIdentifier(indexName) .. " (" .. table.concat(quotedColumns, ", ") .. ")"
  end

  --- Returns the statement adding a column to an existing table.
  function getAddColumnSql(quotedTable: string, columnDefinition: string): string
    return "ALTER TABLE " .. quotedTable .. " ADD COLUMN " .. columnDefinition
  end

  --- Returns whether a foreign key can be added to an existing table with ALTER TABLE ADD CONSTRAINT.
  --- Platforms without it get the reference inline in the column definition instead.
  function supportsAddForeignKey(): boolean
    return true
  end

  --- Returns the statement adding a foreign key constraint to an existing table.
  function getAddForeignKeySql(quotedTable: string, constraintName: string, foreignKeySql: string): string
    return "ALTER TABLE " .. quotedTable .. " ADD CONSTRAINT " .. self:quoteIdentifier(constraintName) .. " " .. foreignKeySql
  end

  --- Returns the statement dropping a table if it exists.
  function getDropTableSql(quotedTable: string): string
    return "DROP TABLE IF EXISTS " .. quotedTable
  end

  --- Returns the statement dropping a column of a table.
  function getDropColumnSql(quotedTable: string, quotedColumn: string): string
    return "ALTER TABLE " .. quotedTable .. " DROP COLUMN " .. quotedColumn
  end

  --- Returns the statement dropping an index of a table.
  function getDropIndexSql(indexName: string, quotedTable: string): string
    return "DROP INDEX IF EXISTS " .. self:quoteIdentifier(indexName)
  end

  --- Returns the statement dropping a foreign key constraint of a table.
  function getDropForeignKeySql(quotedTable: string, constraintName: string): string
    return "ALTER TABLE " .. quotedTable .. " DROP CONSTRAINT " .. self:quoteIdentifier(constraintName)
  end

  --- Returns the statements that are run once before the first query of a connection.
  function getConnectionInitSql(): string[]
    return {}
  end

  --- Returns the statement that starts a transaction.
  function getBeginTransactionSql(): string
    return "BEGIN"
  end

  --- Returns the statement that commits a transaction.
  function getCommitSql(): string
    return "COMMIT"
  end

  --- Returns the statement that rolls back a transaction.
  function getRollbackSql(): string
    return "ROLLBACK"
  end
end

--- The SQL dialect of SQLite. SQLite has dynamic types, so most values are stored as TEXT or INTEGER.
export class SQLitePlatform extends Platform

  override function getName(): string
    return "sqlite"
  end

  override function getStringType(length: number): string
    return "TEXT"
  end

  override function getFixedStringType(length: number): string
    return "TEXT"
  end

  override function getBigIntType(): string
    return "INTEGER"
  end

  override function getFloatType(): string
    return "REAL"
  end

  override function getBooleanType(): string
    return "INTEGER"
  end

  override function getDecimalType(precision: number, scale: number): string
    return "TEXT"
  end

  override function getDateTimeType(): string
    return "TEXT"
  end

  override function getDateType(): string
    return "TEXT"
  end

  override function getUuidType(): string
    return "TEXT"
  end

  override function convertBooleanToDatabase(value: boolean): any
    return value and 1 or 0
  end

  override function getIdentityColumnSql(quotedName: string, sqlType: string): string
    return quotedName .. " INTEGER PRIMARY KEY AUTOINCREMENT"
  end

  override function isIdentityPrimaryKeyInline(): boolean
    return true
  end

  override function getConnectionInitSql(): string[]
    return { "PRAGMA foreign_keys = ON" }
  end

  override function getListTablesSql(): string
    return "SELECT name FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%'"
  end

  override function getListColumnsSql(tablePlaceholder: string): string
    return "SELECT name FROM pragma_table_info(" .. tablePlaceholder .. ")"
  end

  override function getListIndexesSql(tablePlaceholder: string): string
    return "SELECT name FROM pragma_index_list(" .. tablePlaceholder .. ")"
  end

  override function supportsAddForeignKey(): boolean
    return false
  end

  override function getLimitSql(limit: number?, offset: number?): string
    if limit == nil and offset ~= nil then
      return " LIMIT -1 OFFSET " .. math.floor(offset)
    end

    return self:buildLimitSql(limit, offset)
  end
end

--- The SQL dialect of MySQL and MariaDB.
export class MySQLPlatform extends Platform

  override function getName(): string
    return "mysql"
  end

  override function quoteIdentifier(identifier: string): string
    return "`" .. string.gsub(identifier, "`", "``") .. "`"
  end

  override function getFloatType(): string
    return "DOUBLE"
  end

  override function getBooleanType(): string
    return "TINYINT(1)"
  end

  override function getDateTimeType(): string
    return "DATETIME(3)"
  end

  override function getJsonType(): string
    return "JSON"
  end

  override function convertBooleanToDatabase(value: boolean): any
    return value and 1 or 0
  end

  override function getIdentityColumnSql(quotedName: string, sqlType: string): string
    return quotedName .. " " .. sqlType .. " NOT NULL AUTO_INCREMENT"
  end

  override function supportsReturning(): boolean
    return false
  end

  override function getLastInsertIdSql(): string
    return "SELECT LAST_INSERT_ID() AS id"
  end

  override function getLimitSql(limit: number?, offset: number?): string
    if limit == nil and offset ~= nil then
      return " LIMIT 18446744073709551615 OFFSET " .. math.floor(offset)
    end

    return self:buildLimitSql(limit, offset)
  end

  override function getBeginTransactionSql(): string
    return "START TRANSACTION"
  end

  override function createsForeignKeyIndexes(): boolean
    return true
  end

  override function getListTablesSql(): string
    return "SELECT table_name AS name FROM information_schema.tables WHERE table_schema = DATABASE()"
  end

  override function getListColumnsSql(tablePlaceholder: string): string
    return "SELECT column_name AS name FROM information_schema.columns WHERE table_schema = DATABASE() AND table_name = " .. tablePlaceholder
  end

  override function getListIndexesSql(tablePlaceholder: string): string
    return "SELECT DISTINCT index_name AS name FROM information_schema.statistics WHERE table_schema = DATABASE() AND table_name = " .. tablePlaceholder
  end

  override function supportsInlineIndexes(): boolean
    return true
  end

  override function getAddColumnSql(quotedTable: string, columnDefinition: string): string
    return "ALTER TABLE " .. quotedTable .. " ADD " .. columnDefinition
  end

  override function getCreateIndexSql(indexName: string, quotedTable: string, quotedColumns: string[], unique: boolean = false): string
    local keyword = unique and "CREATE UNIQUE INDEX " or "CREATE INDEX "
    return keyword .. self:quoteIdentifier(indexName) .. " ON " .. quotedTable .. " (" .. table.concat(quotedColumns, ", ") .. ")"
  end

  override function getDropIndexSql(indexName: string, quotedTable: string): string
    return "DROP INDEX " .. self:quoteIdentifier(indexName) .. " ON " .. quotedTable
  end

  override function getDropForeignKeySql(quotedTable: string, constraintName: string): string
    return "ALTER TABLE " .. quotedTable .. " DROP FOREIGN KEY " .. self:quoteIdentifier(constraintName)
  end

  override function getLikeEscapeSql(): string
    return " ESCAPE '\\\\'"
  end
end

--- The SQL dialect of PostgreSQL.
export class PostgreSQLPlatform extends Platform

  override function getName(): string
    return "postgresql"
  end

  override function getDecimalType(precision: number, scale: number): string
    return "NUMERIC(" .. precision .. ", " .. scale .. ")"
  end

  override function getDateTimeType(): string
    return "TIMESTAMPTZ(3)"
  end

  override function getUuidType(): string
    return "UUID"
  end

  override function getJsonType(): string
    return "JSONB"
  end

  override function convertDateTimeToDatabase(value: DateTime): any
    return value:toDateTime(TimeZone.UTC):toString(ISO_UTC_FORMAT)
  end

  override function getLikeSql(quotedColumn: string, pattern: string, negated: boolean, caseInsensitive: boolean): string
    if caseInsensitive then
      return quotedColumn .. (negated and " NOT ILIKE " or " ILIKE ") .. pattern .. self:getLikeEscapeSql()
    end

    return quotedColumn .. (negated and " NOT LIKE " or " LIKE ") .. pattern .. self:getLikeEscapeSql()
  end
end

--- Returns the platform for a nanos database engine.
export function createPlatform(engine: DatabaseEngine): Platform
  if engine == DatabaseEngine.SQLite then
    return new SQLitePlatform()
  elseif engine == DatabaseEngine.MySQL then
    return new MySQLPlatform()
  end

  return new PostgreSQLPlatform()
end
